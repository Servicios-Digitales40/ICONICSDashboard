<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS delante del tablero.

  Este archivo va en la raíz del sitio de IIS (p. ej. C:\inetpub\dashboard\),
  NO dentro de la release: sobrevive a los despliegues igual que el
  .env.production.

  Por qué hay un proxy delante, si el backend ya sirve el tablero: porque IIS
  resuelve, con infraestructura que IT ya opera, las dos cosas más caras de la
  lista de bloqueantes del Plan 3 —TLS con el certificado corporativo (P0-4) y
  autenticación contra Active Directory (P0-1.2)—, más compresión, caché y
  cabeceras de seguridad. Escribir eso en la aplicación habría sido semanas de
  trabajo y un sistema de identidad propio que mantener.

  Requiere dos módulos, que no vienen de fábrica:
    · URL Rewrite            https://www.iis.net/downloads/microsoft/url-rewrite
    · Application Request Routing (ARR)

  Y en ARR hay que habilitar el proxy una vez, a nivel de servidor:
    IIS Manager → (servidor) → Application Request Routing Cache
                → Server Proxy Settings → Enable proxy
  Sin ese paso, las reglas de abajo devuelven 404 y no se ve por qué.
-->
<configuration>
  <system.webServer>

    <rewrite>
      <rules>
        <!--
          Todo al backend, que escucha SÓLO en 127.0.0.1: el único camino
          hacia él pasa por aquí, y con él por la autenticación de IIS.
          Comprobar que el servicio no está publicando en 0.0.0.0 es parte de
          la instalación; si lo estuviera, esta barrera se podría saltar
          yendo al puerto 3001 directamente.
        -->
        <rule name="Proxy al tablero" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3001/{R:1}" />
          <serverVariables>
            <!-- Sin esto, el limitador por IP del backend ve la dirección de
                 IIS para TODAS las pantallas y las cuenta como un solo
                 cliente: la primera que se pase corta a las demás. Requiere
                 TRUST_PROXY=true en el .env.production. -->
            <set name="HTTP_X_FORWARDED_FOR" value="{REMOTE_ADDR}" />
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
        </rule>
      </rules>

      <outboundRules>
        <!--
          El index.html NO se cachea y los chunks SÍ, para siempre.

          Los archivos de /assets/ llevan un hash en el nombre, así que un
          cambio produce un nombre nuevo: cachearlos un año es seguro y es lo
          que hace que un wallboard no vuelva a descargar 380 KB de gráficas
          en cada arranque. El index.html es el índice que apunta a esos
          nombres; si se cachea, la pantalla seguirá pidiendo los chunks de la
          release anterior después de un despliegue, y el tablero se queda en
          la versión vieja sin que nadie entienda por qué.
        -->
        <rule name="Cache de los chunks con hash" preCondition="EsAsset">
          <match serverVariable="RESPONSE_Cache_Control" pattern=".*" />
          <action type="Rewrite" value="public, max-age=31536000, immutable" />
        </rule>
        <rule name="Sin cache del index" preCondition="EsDocumento">
          <match serverVariable="RESPONSE_Cache_Control" pattern=".*" />
          <action type="Rewrite" value="no-cache, no-store, must-revalidate" />
        </rule>

        <preConditions>
          <preCondition name="EsAsset">
            <add input="{REQUEST_URI}" pattern="^/assets/" />
          </preCondition>
          <preCondition name="EsDocumento">
            <add input="{RESPONSE_CONTENT_TYPE}" pattern="^text/html" />
          </preCondition>
        </preConditions>
      </outboundRules>
    </rewrite>

    <httpProtocol>
      <customHeaders>
        <!--
          CSP a medida de esta aplicación: todo viene del mismo origen, no hay
          CDN, no hay analítica, no hay fuentes externas. 'unsafe-inline' en
          style-src es necesario porque la interfaz usa estilos en línea de
          forma masiva (ver Plan 2 · A-02, que propone migrarlos a variables
          CSS; hasta entonces, quitarlo deja el tablero sin estilos).
        -->
        <add name="Content-Security-Policy"
             value="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="same-origin" />
        <!-- HSTS: sólo tiene sentido con el certificado ya instalado y
             funcionando. Si se activa antes, un fallo de TLS deja el tablero
             inaccesible en los navegadores que ya lo recordaron. -->
        <add name="Strict-Transport-Security" value="max-age=31536000" />
        <!-- IIS anuncia su versión por defecto; no hay motivo. -->
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <security>
      <requestFiltering>
        <!-- El backend ya limita el cuerpo a 1 MiB; esto lo corta antes de
             llegar, y de paso cubre las rutas que no son de la API. -->
        <requestLimits maxAllowedContentLength="1048576" />
      </requestFiltering>
    </security>

  </system.webServer>

  <!--
    AUTENTICACIÓN — se configura en IIS Manager, no aquí, porque depende del
    dominio. Los pasos, en orden:

      1. Sitio → Authentication:
           Windows Authentication  →  Enabled
           Anonymous Authentication →  Disabled     ← el que suele olvidarse
      2. Sitio → Authorization Rules:
           quitar "Allow All Users"
           añadir Allow → Specified roles: DOMINIO\Operadores-Planta
      3. Comprobar desde otra máquina que un usuario fuera de ese grupo
         recibe 401 y no el tablero.

    El paso 2 es el que convierte «cualquiera de la red» en «quien deba».
    Sin él, habilitar Windows Authentication sólo identifica al usuario: no
    le impide entrar.
  -->
</configuration>
