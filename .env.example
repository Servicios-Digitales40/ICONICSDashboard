# Plantilla de configuracion del backend puente.
#
# Copiala a `.env.local` para desarrollo, o usala como referencia del entorno
# de produccion. Este archivo SI se versiona: no debe contener ningun secreto.
#
#   node --env-file=.env.local backend/server.mjs
#
# La referencia completa de cada variable esta en backend/README.md.

# ── ICONICS ───────────────────────────────────────────────────────────
# Sin ICONICS_API_BASE la API responde 500. Si no es una URL absoluta
# valida, el servidor no arranca y dice cual es el problema.
ICONICS_API_BASE=https://tu-servidor/fwxapi/rest/v1
ICONICS_USERNAME=usuario-de-servicio
ICONICS_PASSWORD=
# Punto que leen /api/iconics/data y /api/context cuando no se indica otro.
ICONICS_POINT_NAME=

# Escritura y reconocimiento de alarmas. Por defecto DESHABILITADAS: el
# puente mantiene una sesion privilegiada contra ICONICS, y una instalacion
# que nadie configuro no debe poder escribir en la planta. En produccion no
# se pone esta linea; en desarrollo se pone a "false" si se usa la vista Data.
# Ojo: el asistente tambien la respeta. Con esto sin poner, `controlar_bomba`
# se niega a encender o apagar la bomba y lo explica en la respuesta.
#ICONICS_READ_ONLY=false

# ── Servidor ──────────────────────────────────────────────────────────
PORT=3001
LOG_LEVEL=INFO
# Build del frontend que se sirve. Relativo a la raiz del repo, o absoluto.
STATIC_DIR=react-dashboard/dist
# Que build corre. Lo inyecta el empaquetado desde `git describe`; se ve en
# /api/health y es lo primero que hace falta cuando alguien reporta un fallo.
APP_VERSION=dev
# Cambia a production en el servidor: endurece comprobaciones de arranque.
NODE_ENV=development

# ── Red ───────────────────────────────────────────────────────────────
# El backend escucha en 0.0.0.0, asi que el puerto es alcanzable desde la red
# en cuanto el firewall lo permita. En Windows, una sola vez y como
# administrador: scripts/exponer-en-red.ps1
#
# Origenes autorizados a llamar a la API desde OTRO origen, separados por
# comas. Se deja VACIO: no hace falta CORS en ninguno de los dos despliegues,
# porque en los dos la API vive en el mismo origen que la pagina. En planta
# porque el backend sirve el bundle; en desarrollo porque el dev server de
# Vite reenvia /api al backend (`server.proxy` en vite.config.js).
#
# Si algun dia hace falta, se listan uno a uno con esquema y puerto. Ojo: la
# comparacion es por igualdad exacta y NO existe el comodin `*`; ponerlo
# autoriza a un origen llamado literalmente "*", o sea a nadie.
#CORS_ORIGINS=http://localhost:5173

# Ponlo a true SOLO si hay un proxy inverso delante. Sin esto, el limitador
# ve la IP del proxy para todos los clientes y cuenta a la planta entera como
# uno solo. Con el puente expuesto directamente debe quedarse en false,
# porque X-Forwarded-For la falsifica cualquiera.
#TRUST_PROXY=true

# Limite por cliente. El defecto (300/min) corta un bucle desbocado sin
# molestar a un wallboard, que gasta ~4-12 peticiones/min.
#RATE_LIMIT_MAX=300
#RATE_LIMIT_WINDOW_MS=60000

# ── Ajuste fino ───────────────────────────────────────────────────────
# Corte de cualquier llamada saliente hacia ICONICS. Subelo si el servidor
# de esta planta es lento; nunca lo quites.
#UPSTREAM_TIMEOUT_MS=15000

# Caches de las lecturas en lote: colapsa en una sola llamada lo que piden
# todas las pantallas a la vez. 0 la desactiva.
#BATCH_CACHE_TTL_MS=2000

# ── Asistente de lenguaje natural (Planes 6 y 7) ──────────────────────
# Base de llama-server. VACIA por defecto, y ese defecto importa: sin ella
# /api/chat responde 503 y el frontend no pinta el asistente. El tablero
# funciona igual. Una instalacion que nadie configuro no expone un
# asistente a medias.
#
# llama-server tiene que escuchar en 127.0.0.1 (no en 0.0.0.0): no lleva
# autenticacion de ninguna clase. Y hay que arrancarlo con --jinja, o el
# modelo no ve las herramientas y contesta de memoria.
#IA_BASE=http://127.0.0.1:8080

# Corte de la llamada al modelo. NO reutiliza UPSTREAM_TIMEOUT_MS a
# proposito: son dos escalas distintas, y 15 s es holgado para ICONICS pero
# ridiculo para un modelo de lenguaje.
#
# El defecto queda holgado aunque hoy sobre. Con el Qwen 4B, que cabe entero
# en la 4060, una respuesta son 4-5 s; pero basta cambiar el -m de
# llama-server por un modelo que no quepa para volver a descarga parcial en
# CPU y a los 30-90 s del 9B. Este numero no deberia obligar a tocar nada
# cuando eso pase.
#IA_TIMEOUT_MS=180000

# Tope de tokens de la respuesta. Cuidado: en Qwen3.5 los tokens de
# razonamiento salen por `reasoning_content` pero gastan de este mismo
# presupuesto, asi que un tope corto se lo come el modelo pensando y deja la
# burbuja vacia. La red de seguridad del backend redacta si eso pasa.
#IA_MAX_TOKENS=512

# Nombre del modelo. llama-server sirve uno solo, asi que esto es informativo
# y solo se ve en las trazas.
#IA_MODELO=local

# Cuantas herramientas puede ENCADENAR el modelo para una sola pregunta.
#
# Hasta que existio esto el bucle daba una consulta y punto, y con una sola
# consulta la pregunta que mas importa —"por que fallo esto?"— no se puede
# contestar: hace falta el estado, la historia de la senal sospechosa y a
# veces el manual. Tres cubre el diagnostico completo.
#
# Es configurable porque el precio lo pone el hardware, no el codigo: en una
# GPU holgada cada paso son segundos; con el modelo a medias en CPU, tres
# pasos son un par de minutos de espera y quiza convenga bajarlo a 2. El
# backend no ejecuta mas de IA_MAX_PASOS*2 herramientas por turno, y una
# consulta identica repetida no se vuelve a ejecutar.
#IA_MAX_PASOS=3

# Carpeta con la documentacion de planta: manuales, hojas de datos,
# procedimientos. VACIO por defecto: sin esto, la herramienta de consultar
# documentacion dice que este servidor no tiene manuales cargados en vez de
# contestar de memoria sobre un equipo que nadie le ha descrito.
#
# Se leen .txt, .md, .csv, .log y .pdf. Del PDF se extrae el texto sin
# dependencias (zlib de Node), lo que cubre los manuales generados por Word o
# InDesign; un PDF ESCANEADO es una imagen y no se puede leer sin OCR — el
# indice lo detecta y lo dice en vez de indexar basura.
#
# La ruta puede ser absoluta o relativa a la raiz del proyecto. La carga es
# perezosa: no retrasa el arranque, se hace en la primera consulta.
#IA_DOCS_DIR=Documentos

# Segundo llama-server, SOLO para embeddings de la documentacion.
#
# VACIO por defecto, y ese defecto es la decision: llama-server sirve un
# modelo a la vez, asi que el que atiende el chat no puede ademas generar
# embeddings, y pedirselos devuelve los de un modelo generativo, que para
# buscar son malos. Sin esto la documentacion se busca con BM25 —lexico, sin
# servidor, sin dependencias—, que en manuales tecnicos acierta porque quien
# pregunta usa el vocabulario del manual.
#
# Si se configura, apunta a un llama-server arrancado con --embedding sobre un
# modelo de embeddings, y los dos metodos se mezclan (60% semantico, 40%
# lexico): el coseno encuentra "como se pone a cero" cuando el manual dice
# "ajuste del offset", y BM25 clava las referencias tipo "PMP63B" o "F270",
# que un embedding disuelve.
#IA_EMBEDDING_BASE=http://127.0.0.1:8081
#IA_EMBEDDING_MODELO=local

# IA_MAQUINAS_CON_HISTORIA se retiro: el asistente responde sobre el sistema
# de agua (ac:TDCON/DEMO/SENSORES/) y alli que una senal tenga historia no es
# configurable. A tres de las ocho el historiador les devuelve LA SERIE DE
# OTRA sin dar error, asi que la marca vive como hecho medido en
# shared/eva/senales.js (campo `historizado`) y no en una variable de entorno.

# Horario de turnos, para poder preguntar "el turno de la manana del 20 de
# julio". VACIO por defecto, y ese defecto es la decision: sin el horario
# real de esta planta, un turno inventado devolveria datos verdaderos de las
# horas equivocadas, que es indistinguible de la respuesta correcta. Con esto
# vacio, preguntar por un turno responde que no esta configurado y ofrece
# preguntar por una hora concreta.
#
# Formato: nombre=horaInicio-horaFin, separados por comas. Un turno de noche
# puede cruzar la medianoche (22-6).
#IA_TURNOS=manana=6-14,tarde=14-22,noche=22-6

# ── Contexto de cabecera (mientras no haya sesion real) ───────────────
#DEFAULT_USUARIO=Operador
#DEFAULT_LINEA=Linea 1
#DEFAULT_EQUIPO=Equipo principal
#DEFAULT_TURNO=Matutino
#DEFAULT_RENDIMIENTO=84%

# ── El frontend NO se configura aqui ──────────────────────────────────
# Vite solo lee variables de SU directorio, asi que estas van en
# `react-dashboard/.env.local` y no en este archivo. Se hornean en el bundle
# al compilar: cambiarlas obliga a recompilar, y en produccion no debe
# aparecer ni VITE_ICONICS_FAKE ni VITE_ENABLE_SIMULATOR.
#
#   VITE_API_BASE           Base del backend. Vacia = mismo origen, que es
#                           lo correcto en produccion (el puente sirve el
#                           bundle). En desarrollo, http://localhost:3001
#   VITE_ICONICS_FAKE       Transporte falso, sin servidor de planta
#   VITE_ICONICS_CHAOS      Presets de latencia y fallos, para probar los
#                           caminos tristes
#   VITE_ENABLE_SIMULATOR   Anade el origen simulado al selector
#   VITE_APP_VERSION        La inyecta vite.config desde `git describe`; no
#                           se pone a mano

# ── Certificados ──────────────────────────────────────────────────────
# Desactiva la verificacion de certificados de TODO el proceso, no solo de
# la llamada a ICONICS. En desarrollo hace falta por el certificado
# auto-firmado del servidor de planta; con NODE_ENV=production el arranque
# falla a proposito antes que arrancar inseguro.
#NODE_TLS_REJECT_UNAUTHORIZED=0

# La solucion buena, y la unica valida en el servidor: dar de alta la CA de
# ICONICS en vez de apagar la verificacion. La lee Node directamente, no
# este backend, asi que no aparece en config.mjs.
#NODE_EXTRA_CA_CERTS=/ruta/a/iconics-ca.crt

# ── Dictado por voz (whisper.cpp) ─────────────────────────────────────
#
# Apunta a `whisper-server`, que se arranca aparte igual que llama-server:
#
#   whisper.cppin\Release\whisper-server.exe ^
#     -m whisper.cpp\models\ggml-small.bin -l es -t 4 --port 8082 --host 127.0.0.1
#
# (hay un atajo en scripts/whisper.ps1)
#
# VACIO por defecto: sin esto la ruta /api/voz responde 503 diciendo que falta
# la variable, y el panel no pinta el boton del microfono. Misma regla de la
# casa que IA_BASE: una instalacion que nadie configuro no expone una funcion
# a medias.
#
# whisper-server tiene que escuchar en 127.0.0.1, igual que llama-server: no
# lleva autenticacion de ninguna clase.
#
# El audio llega ya convertido a WAV de 16 kHz desde el NAVEGADOR (Web Audio
# API), asi que NO hace falta arrancarlo con --convert ni instalar ffmpeg.
#IA_WHISPER_BASE=http://127.0.0.1:8082

# Idioma del dictado. Fijo y NO 'auto' a proposito: con deteccion automatica,
# una frase corta con ruido de planta se confunde a menudo con portugues o
# italiano, y la transcripcion sale traducida a un idioma que nadie pidio.
#IA_WHISPER_IDIOMA=es

# Corte de una transcripcion. En CPU, whisper small tarda algo menos que la
# duracion del audio; en GPU sobra de largo.
#IA_WHISPER_TIMEOUT_MS=60000
