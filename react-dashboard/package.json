{
  "name": "eva-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Tablero del sistema de agua industrial (Demo EVA): las señales de ac:TDCON/DEMO/SENSORES/ leídas de ICONICS, en 2D y en 3D, con un asistente de lenguaje natural opcional.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "design:detect": "npx -y impeccable@3 detect src index.html",
    "design:detect:json": "npx -y impeccable@3 detect --json src index.html"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "lucide-react": "^0.383.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^29.1.1",
    "vite": "^5.4.21",
    "vitest": "^4.1.10"
  }
}
