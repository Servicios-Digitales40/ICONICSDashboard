node_modules/
dist/
build/

# Reportes PDF generados por el asistente (Plan 14 Fase 5): datos, no codigo.
Reportes/

# Paquetes de release: se generan desde el codigo, no se versionan.
# Para distribuirlos, sube el .zip como asset de un GitHub Release.
dist-release/

# Variables de entorno y credenciales
.env
.env.*
*.local

# La plantilla sí se versiona: documenta las variables y no lleva secretos.
!.env.example

# Ajustes locales de herramientas
.claude/settings.local.json

# Logs
*.log
npm-debug.log*

# Sistema
.DS_Store
Thumbs.db



# Datos que genera el backend en marcha: reportes en PDF y lo que el
# asistente va aprendiendo. Lo DURADERO no vive aqui: cuando un hecho
# demuestra que vale, se sube a HECHOS_INICIALES en shared/eva/aprendizaje.js,
# donde pasa por revision como cualquier otro codigo.
datos/
