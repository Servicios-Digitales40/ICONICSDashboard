node_modules/
dist/
build/

# PDF que este backend GENERA (Plan 14 Fase 5, Plan 16): reportes de
# generar_reporte y exportaciones de chat, cada uno en su propia subcarpeta
# (ver IA_REPORTES_DIR e IA_BACKLOG_CHAT_DIR en .env.example). Datos, no
# codigo.
Documentos/
Reportes/
# Manuales de planta que alimentan el RAG del asistente (Plan 16), subidos
# desde el tablero o dejados a mano (ver IA_DOCS_DIR en .env.example). No es
# codigo de este repositorio: es documentacion de UNA instalacion concreta,
# y puede llevar informacion que no corresponde subir a un repositorio
# compartido.
Documentacion/

# Paquetes de release: se generan desde el codigo, no se versionan.
# Para distribuirlos, sube el .zip como asset de un GitHub Release.
dist-release/

# Variables de entorno y credenciales
.env
.env.*
*.local

# La plantilla sí se versiona: documenta las variables y no lleva secretos.
!.env.example

# Ajustes locales de herramientas
.claude/settings.local.json

# Logs
*.log
npm-debug.log*

# Sistema
.DS_Store
Thumbs.db



# Datos que genera el backend en marcha: reportes en PDF y lo que el
# asistente va aprendiendo. Lo DURADERO no vive aqui: cuando un hecho
# demuestra que vale, se sube a HECHOS_INICIALES en shared/eva/aprendizaje.js,
# donde pasa por revision como cualquier otro codigo.
datos/
